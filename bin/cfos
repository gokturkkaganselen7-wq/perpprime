#!/usr/bin/env bash
# CFOS launcher. Works from any directory; no package installation required.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="${CFOS_PYTHON:-$ROOT/.venv/bin/python}"
if [[ ! -x "$PYTHON" ]]; then
  echo "cfos: python not found at $PYTHON (run: uv venv .venv && uv pip install --python .venv/bin/python ccxt)" >&2
  exit 2
fi
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON" -m cfos "$@"
