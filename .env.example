# ---------------------------------------------------------------------------
# CFOS environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# paper | testnet | live   (paper is the default and needs no keys)
CFOS_MODE=paper

# Venue id understood by CCXT: bybit | binanceusdm | okx | kucoinfutures ...
CFOS_VENUE=bybit

# Starting equity for paper mode. Ignored by testnet/live (read from the venue).
CFOS_EQUITY=10000

# Exchange credentials. Create a TRADE-ONLY key: no withdrawal permission,
# IP allowlist enabled, futures trading enabled.
CFOS_API_KEY=
CFOS_API_SECRET=
CFOS_API_PASSWORD=

# Required for live orders. Set to I_UNDERSTAND_REAL_MONEY only when you do.
CFOS_LIVE_ACK=

# Optional paths
# CFOS_HOME=/absolute/path/to/cfos
# CFOS_DATA_DIR=/absolute/path/to/cfos/data
# CFOS_KILL_FILE=/absolute/path/to/cfos/data/KILL

# Optional: keep the model from ever seeing order payloads in logs
CFOS_LOG_LEVEL=INFO
